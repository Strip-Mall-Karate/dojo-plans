#!/usr/bin/env bash
# Runs the plan builder: a container on the build host (smk-1 unless DOJO_BUILD_HOST says
# otherwise) with Ubuntu as stage 0, swamp and doj-plan-build. Run from a dojo-plans checkout on
# the Mac. tools/builder/README.md says what each command does and why.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly BUILD_HOST="${DOJO_BUILD_HOST:-smk-1}"
readonly IMAGE=dojo-builder
readonly CONTAINER=dojo-builder
readonly ROOT_VOLUME=dojo-root
# On the build host: the plans, Dojo's plan crate and the builder's home, mounted at /work.
readonly HOST_DIR=dojo-builder
# The karate origin's signing key pair, each key file base64-encoded in its own field. Neither the
# image nor ~/dojo-builder on the host holds it: `key` puts it in the /doj volume.
readonly KEY_ITEM="op://OMG SecOps/karate origin signing key"
# state.py's exit status when something builds from /work/plans, and when only runs swamp never
# finished are left.
readonly EXIT_RUNNING=3
readonly EXIT_INTERRUPTED=4
# wait: how often it asks, and how many ssh failures in a row it rides out (ten minutes).
readonly WAIT_SECONDS=30
readonly WAIT_SSH_FAILURES=20

usage() {
  echo >&2 "usage: $(basename "$0") image | start | sync [--force] | tools <dojo-checkout> | key | dojo <dojo-checkout> | standins | status | wait | failures | check-wrapper | run <command>... | shell | stop | remove"
  exit 2
}

# Callers pass a script for the host with this machine's values already expanded into it.
# shellcheck disable=SC2029
on_host() { ssh "${BUILD_HOST}" "$@"; }

# The committed tree of a checkout, unpacked on the build host into ~/dojo-builder/<name> over
# what was there, keeping the paths named in the remaining arguments. Files get the time they were
# unpacked, not the commit's, so cargo rebuilds what changed after its last build.
send_tree() {
  local checkout=$1 path=$2 name=$3
  shift 3
  local keep=()
  for k in "$@"; do keep+=("--exclude=${k}"); done
  git -C "${checkout}" archive --format=tar HEAD -- "${path}" |
    on_host "set -e; s=\$(mktemp -d); trap 'rm -rf \"\$s\"' EXIT; tar -xmf - -C \"\$s\";
               mkdir -p ${HOST_DIR}/${name};
               rsync -a --delete ${keep[*]} \"\$s/${path%/}/\" ${HOST_DIR}/${name}/"
}

# state.py in the container, from swamp's repository: it reads swamp's records and the processes.
state() { on_host "docker exec -i -w /work/plans/swamp ${CONTAINER} python3 -I - $1" <"${SCRIPT_DIR}/state.py"; }

(($# >= 1)) || usage
command=$1
shift

case "${command}" in
image)
  tar -C "${SCRIPT_DIR}" -cf - Containerfile cc-wrapper |
    on_host "set -e; s=\$(mktemp -d); trap 'rm -rf \"\$s\"' EXIT; tar -xf - -C \"\$s\";
                 docker build -f \"\$s/Containerfile\" -t ${IMAGE} \
                   --build-arg BUILDER_UID=\$(id -u) --build-arg BUILDER_GID=\$(id -g) \"\$s\""
  ;;
start)
  on_host "set -e; mkdir -p ${HOST_DIR}/home;
             docker volume create ${ROOT_VOLUME} >/dev/null;
             docker run -d --name ${CONTAINER} --cpus 16 --memory 32g --restart unless-stopped \
               -v ${ROOT_VOLUME}:/doj -v \$HOME/${HOST_DIR}:/work -e HOME=/work/home \
               -e PATH=/work/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
               ${IMAGE};
             docker exec ${CONTAINER} mkdir -p /doj/cache/keys /work/bin"
  ;;
sync)
  (($# == 0)) || [[ $# == 1 && "$1" == --force ]] || usage
  if [[ $# == 0 ]]; then
    status=0
    found=$(state running) || status=$?
    if ((status == EXIT_RUNNING || status == EXIT_INTERRUPTED)); then
      printf '%s\n' "${found}" >&2
      echo >&2 "Not syncing: a workflow re-reads /work/plans at every wave. Wait for it, or sync --force."
      exit 1
    elif ((status != 0)); then
      echo >&2 "Not syncing: could not tell whether anything builds (exit ${status})."
      exit "${status}"
    fi
  fi
  send_tree "$(git rev-parse --show-toplevel)" . plans swamp/.swamp/ swamp/results/ results/
  ;;
tools)
  # doj-plan-build, and the doj it signs packages with, from the checkout's committed tree. Both
  # build with the image's Rust, so a builder with no karate packages yet has them.
  (($# == 1)) || usage
  send_tree "$1" components/plan/ dojo-plan target/
  send_tree "$1" . dojo target/
  exec ssh "${BUILD_HOST}" "docker exec ${CONTAINER} nice -n 15 sh -c '
      cargo build --release --manifest-path /work/dojo-plan/Cargo.toml --target-dir /work/dojo-plan/target &&
      ln -sf /work/dojo-plan/target/release/doj-plan-build /work/bin/doj-plan-build &&
      doj-plan-build show /work/plans/zlib --target x86_64-linux >/dev/null && echo doj-plan-build ready &&
      cargo build --release --locked --manifest-path /work/dojo/Cargo.toml --target-dir /work/dojo/target -p doj --bin doj &&
      ln -sf /work/dojo/target/release/doj /work/bin/doj && doj --version'"
  ;;
key)
  # The origin's public and secret keys from 1Password, through doj, which checks each and writes
  # it to /doj/cache/keys.
  (($# == 0)) || usage
  for field in "public key" "secret key"; do
    op read "${KEY_ITEM}/${field}" | base64 -d |
      on_host "docker exec -i -e DOJ_CACHE_KEY_PATH=/doj/cache/keys ${CONTAINER} doj origin key import"
  done
  ;;
dojo)
  # The whole checkout, for building Dojo's own component plans at /work/dojo/components/<name>.
  (($# == 1)) || usage
  send_tree "$1" . dojo target/
  ;;
standins)
  # An empty karate/<name>/0.0.0 package for every base plan, so a first build resolves its
  # dependencies; the tools themselves are the container's, on PATH. A real build of the
  # package is a newer version and replaces the stand-in. doj lists only a package whose TARGET
  # is the one it runs on.
  on_host "docker exec ${CONTAINER} sh -c '
      for name in \$(sed -n \"s|^dojo-plans/\\([^ ]*\\).*|\\1|p\" /work/plans/base-plans.txt | sort -u); do
        dir=/doj/pkgs/karate/\$name/0.0.0/20200101000000
        mkdir -p \$dir && echo karate/\$name/0.0.0/20200101000000 > \$dir/IDENT &&
          printf x86_64-linux > \$dir/TARGET
      done; ls /doj/pkgs/karate | wc -l'"
  ;;
status | failures)
  (($# == 0)) || usage
  state "${command}"
  ;;
wait)
  (($# == 0)) || usage
  failures=0
  while :; do
    status=0
    found=$(state running) || status=$?
    case "${status}" in
    0 | "${EXIT_INTERRUPTED}") exit "${status}" ;;
    "${EXIT_RUNNING}")
      failures=0
      echo >&2 "$(date +%T) building: ${found//$'\n'/; }"
      ;;
    255)
      ((++failures <= WAIT_SSH_FAILURES)) || exit 255
      echo >&2 "$(date +%T) ssh to ${BUILD_HOST} failed (${failures} of ${WAIT_SSH_FAILURES}); asking again in ${WAIT_SECONDS}s"
      ;;
    *) exit "${status}" ;;
    esac
    sleep "${WAIT_SECONDS}"
  done
  ;;
check-wrapper)
  # tools/builder/check_wrapper.py with this checkout's gcc/cc-wrapper.sh, as the working tree has them.
  (($# == 0)) || usage
  top=$(git rev-parse --show-toplevel)
  tar -C "${top}" -cf - tools/builder/check_wrapper.py gcc/cc-wrapper.sh |
    on_host "docker exec -i ${CONTAINER} sh -c 's=\$(mktemp -d); trap \"rm -rf \$s\" EXIT; tar -xf - -C \$s &&
      nice -n 15 python3 -I \$s/tools/builder/check_wrapper.py \$s/gcc/cc-wrapper.sh'"
  ;;
run)
  (($# >= 1)) || usage
  exec ssh -t "${BUILD_HOST}" "docker exec -it -w /work/plans/swamp ${CONTAINER} nice -n 15 $(printf '%q ' "$@")"
  ;;
shell)
  exec ssh -t "${BUILD_HOST}" "docker exec -it -w /work/plans/swamp ${CONTAINER} bash"
  ;;
stop)
  on_host "docker stop ${CONTAINER}"
  ;;
remove)
  on_host "docker rm -f ${CONTAINER} && docker volume rm ${ROOT_VOLUME}"
  ;;
*)
  usage
  ;;
esac
