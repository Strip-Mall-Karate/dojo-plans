#!/usr/bin/env bash
# A stand-in for `doj`, the two things doj-plan-build asks of it, until Dojo's own doj builds
# with the current toolchain:
#   doj pkg path <ident>                     the newest installed package matching ident
#   doj pkg sign --origin <o> <src> <dest>   writes src with a header line: NOT A SIGNATURE
set -euo pipefail

root=${DOJ_ROOT_PATH:-/doj}

if [[ $# -ge 3 && "$1" == pkg && "$2" == path ]]; then
  dir="${root}/pkgs/$3"
  [[ -d "${dir}" ]] || exit 1
  while [[ ! -f "${dir}/IDENT" ]]; do
    next=$(find "${dir}" -mindepth 1 -maxdepth 1 -type d | sort -V | tail -1)
    [[ -n "${next}" ]] || exit 1
    dir=${next}
  done
  printf '%s\n' "${dir}"
  exit 0
fi

if [[ $# -ge 2 && "$1" == pkg && "$2" == sign ]]; then
  # doj pkg sign --origin <origin> <src> <dest>
  args=("$@")
  n=${#args[@]}
  (( n == 6 )) && [[ "${args[2]}" == --origin ]] \
    || { echo "doj (stand-in): expected pkg sign --origin <origin> <src> <dest>" >&2; exit 2; }
  { printf 'unsigned by the doj stand-in for origin %s\n' "${args[3]}"; cat "${args[4]}"; } > "${args[5]}"
  exit 0
fi

echo "doj (stand-in): only 'pkg path' and 'pkg sign' are provided: $*" >&2
exit 2
