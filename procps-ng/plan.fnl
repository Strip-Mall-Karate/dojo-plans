;; procps-ng, ported from its plan.sh.
{:name "procps-ng"
 :origin "karate"
 :version "3.3.15"
 :targets ["x86_64-linux"]
 :maintainer "Strip Mall Karate Company"
 :license ["gpl" "lgpl"]
 :description "Command line and full screen utilities for browsing procfs, a pseudo file system dynamically generated by the kernel to provide information about the status of entries in its process table."
 :upstream_url "https://gitlab.com/procps-ng/procps"
 :source {:url "https://downloads.sourceforge.net/project/procps-ng/Production/procps-ng-3.3.15.tar.xz" :sha256 "10bd744ffcb3de2d591d2f6acf1a54a7ba070fdcc432a855931a5057149f0465"}
 :deps ["karate/glibc" "karate/ncurses"]
 :build_deps ["karate/coreutils" "karate/diffutils" "karate/patch" "karate/make" "karate/gcc"]
 :bin_dirs ["bin"]
 :lib_dirs ["lib"]
 :include_dirs ["include"]
 :pconfig_dirs ["lib/pkgconfig"]
 :build (fn [b]
          (b:run ["./configure" (.. "--prefix=" b.prefix) (.. "--sbindir=" b.prefix "/bin") "--disable-kill"])
          (b:run ["make"]))
 :check (fn [b]
          (b:run ["make" "check"]))}
