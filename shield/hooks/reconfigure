#!/bin/bash

echo "Restarting shield-proxy"

if doj sup status | grep shield-proxy; then
  doj svc unload karate/shield-proxy
fi

mkdir -p /doj/svc/shield-proxy/
cp {{pkg.svc_config_path}}/shield-proxy.toml /doj/svc/shield-proxy/user.toml
doj svc load karate/shield-proxy --group {{svc.group}} --force
